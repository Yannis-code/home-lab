set shell := ["bash", "-cu"]

project_dir := source_directory()

# List of available commands
default:
	@just --list

[private]
venv:
	@if [[ ! -x "{{project_dir}}/.venv/bin/python" ]]; then \
	  python3 -m venv "{{project_dir}}/.venv"; \
	fi

# Install the project and its dev dependencies into a local virtual environment
sync: venv
	@"{{project_dir}}/.venv/bin/pip" install --quiet --disable-pip-version-check --upgrade pip
	@"{{project_dir}}/.venv/bin/pip" install --quiet --disable-pip-version-check -e "{{project_dir}}[dev]"

# Run the unit test suite (pure business logic, no HTTP/DB)
test-unit: sync
	@cd "{{project_dir}}" && .venv/bin/python -m pytest tests/unit -q

# Run the integration test suite (FastAPI + SQLite in-memory)
test-integration: sync
	@cd "{{project_dir}}" && .venv/bin/python -m pytest tests/integration -q

# Run the full test suite
test: sync
	@cd "{{project_dir}}" && .venv/bin/python -m pytest -q

# Run the development server on http://127.0.0.1:8000
serve: sync
	@cd "{{project_dir}}" && .venv/bin/uvicorn covoit.main:app --app-dir src --reload --host 127.0.0.1 --port 8000
