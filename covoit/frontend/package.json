{
  "name": "covoit-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:coverage": "cross-env VITE_COVERAGE=true vite",
    "build": "vue-tsc -b && vite build",
    "preview": "vite preview",
    "test:e2e": "playwright test",
    "coverage:report": "nyc report",
    "coverage:check": "nyc check-coverage",
    "test:e2e:coverage": "rimraf .nyc_output coverage && playwright test && npm run coverage:report && npm run coverage:check"
  },
  "dependencies": {
    "vue": "^3.5.13",
    "vue-router": "^4.5.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.49.1",
    "@vitejs/plugin-vue": "^5.2.1",
    "@vue/tsconfig": "^0.7.0",
    "cross-env": "^7.0.3",
    "nyc": "^18.0.0",
    "rimraf": "^6.0.1",
    "typescript": "~5.7.2",
    "vite": "^6.0.5",
    "vite-plugin-istanbul": "^6.0.2",
    "vite-plugin-pwa": "^0.21.1",
    "vue-tsc": "^2.2.0"
  }
}
