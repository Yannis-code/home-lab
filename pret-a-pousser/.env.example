# BLE target
POTAGER_ADDRESS=AA:BB:CC:DD:EE:FF
POTAGER_ADAPTER=hci1
POTAGER_CONNECT_TIMEOUT=15
POTAGER_RETRIES=2
POTAGER_TOPIC_PREFIX=potager/modulo2
POTAGER_LOG_LEVEL=INFO
POTAGER_DEBUG=0
# Optional for CLI auto-save/auto-restore one-shot commands only.
POTAGER_AUTO_STATE_FILE=/data/auto_mode_state.json

# MQTT topics derived from POTAGER_TOPIC_PREFIX
# Input:
# - <prefix>/state/set         : off|auto|manuel|faible|printemps|ete|photo (ete with accent is also accepted)
# - <prefix>/save              : trigger
# - <prefix>/auto              : JSON profile (update profile auto)
# - <prefix>/manuel            : JSON profile (update profile manuel)
# Output:
# - <prefix>/state
# - <prefix>/clock
# - <prefix>/auto
# - <prefix>/manuel
# - <prefix>/status/device-write
# - <prefix>/status/active-profile
# - <prefix>/status/last-command
# - <prefix>/availability

# MQTT broker (Home Assistant Mosquitto)
MQTT_HOST=192.168.1.50
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=potager-ble-bridge

# MQTT web client exposed through Traefik (HTTPS + basic auth middleware)
MQTT_WEB_HOST=mqtt.doudou.house
MQTT_EXPLORER_USERNAME=
MQTT_EXPLORER_PASSWORD=
