# BLE target
POTAGER_NAME=Modulo2
POTAGER_ADAPTER=hci1
POTAGER_SCAN_TIMEOUT=15
POTAGER_CONNECT_TIMEOUT=15
POTAGER_RETRIES=2
POTAGER_STATE_FILE=/data/last_mac.txt
POTAGER_TOPIC_PREFIX=potager/modulo2
POTAGER_DEBUG=0
POTAGER_AUTO_STATE_FILE=/data/auto_mode_state.json

# MQTT topics derived from POTAGER_TOPIC_PREFIX
# - <prefix>/set               : ON/OFF
# - <prefix>/channels/set      : JSON batch set for protocol fields
#     Example payload:
#     {"left_intensity":"printemps","right_intensity":"printemps","left_start":"08:00","right_start":"08:00","left_end":"22:00","right_end":"22:00","clock_now":true}
# - <prefix>/left/intensity/set  : intensity gauche (off|photo|faible|printemps|ete|0..255)
# - <prefix>/right/intensity/set : intensity droite
# - <prefix>/left/start/set      : debut gauche HH:MM[:SS]
# - <prefix>/right/start/set     : debut droit HH:MM[:SS]
# - <prefix>/left/end/set        : fin gauche HH:MM[:SS]
# - <prefix>/right/end/set       : fin droit HH:MM[:SS]
# - <prefix>/clock/set           : NOW | HH:MM[:SS] | secondes depuis minuit
# - <prefix>/left/profile-param/set  : ecriture brute hex/decimal
# - <prefix>/right/profile-param/set : ecriture brute hex/decimal
# - <prefix>/reserved/set            : ecriture brute hex/decimal
# - <prefix>/auto/save/set     : trigger auto-save (payload: 1|ON|SAVE or empty)
# - <prefix>/auto/restore/set  : trigger auto-restore (payload: 1|ON|RESTORE or empty)
# - <prefix>/auto/saved        : JSON status of last auto-save
# - <prefix>/auto/restored     : JSON status of last auto-restore
# - <prefix>/error             : error messages

# MQTT broker (Home Assistant Mosquitto)
MQTT_HOST=192.168.1.50
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=potager-ble-bridge
