# BLE target
POTAGER_NAME=Modulo2
POTAGER_ADAPTER=hci1
POTAGER_SCAN_TIMEOUT=15
POTAGER_CONNECT_TIMEOUT=15
POTAGER_RETRIES=2
POTAGER_STATE_FILE=/data/last_mac.txt
POTAGER_TOPIC_PREFIX=potager/modulo2
POTAGER_DEBUG=0

# MQTT broker (Home Assistant Mosquitto)
MQTT_HOST=192.168.1.50
MQTT_PORT=1883
MQTT_USERNAME=
MQTT_PASSWORD=
MQTT_CLIENT_ID=potager-ble-bridge
