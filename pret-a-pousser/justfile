set shell := ["bash", "-cu"]

project_dir := justfile_directory()
image := "potager-ble:latest"
uv_image := "ghcr.io/astral-sh/uv:python3.12-bookworm-slim"
default_address := ""
default_adapter := "hci0"
default_topic := "potager/modulo2/set"
default_host := "127.0.0.1"
default_port := "1883"

# List of available commands
default:
	@just --list

[private]
uv command:
	@if command -v uv >/dev/null 2>&1; then \
	  cd "{{project_dir}}" && uv {{command}}; \
	else \
	  docker run --rm -v "{{project_dir}}:/app" -w /app {{uv_image}} uv {{command}}; \
	fi

[private]
py command:
	@if command -v python3 >/dev/null 2>&1; then \
	  cd "{{project_dir}}"; \
	  if [[ -x .venv/bin/python ]]; then \
	    .venv/bin/python {{command}}; \
	  else \
	    python3 {{command}}; \
	  fi; \
	else \
	  echo "python3 introuvable sur l'hote"; \
	  exit 1; \
	fi

# Generate or update uv.lock
lock:
	@just uv lock

# Install dependencies into local virtual environment
sync:
	@if [[ -f uv.lock ]]; then \
	  just uv "sync --frozen --no-dev"; \
	else \
	  just uv lock; \
	  just uv "sync --frozen --no-dev"; \
	fi

# Diagnose local BLE runtime, Python modules, and adapter visibility
doctor adapter=default_adapter:
	@cd "{{project_dir}}"; \
	set +e; \
	echo "== project =="; \
	echo "dir: $(pwd)"; \
	echo "user: $(id -un) uid=$(id -u)"; \
	echo; \
	echo "== python =="; \
	if [[ -x .venv/bin/python ]]; then \
	  PY=.venv/bin/python; \
	else \
	  PY=python3; \
	fi; \
	echo "interpreter: $PY -> $($PY -c 'import sys; print(sys.executable)' 2>/dev/null || echo unavailable)"; \
	$PY -c "import sys; print('version:', sys.version.split()[0])" 2>/dev/null || true; \
	$PY -c "import bleak; print('bleak: OK')" 2>/dev/null || echo "bleak: MISSING"; \
	$PY -c "import paho.mqtt.client as _; print('paho-mqtt: OK')" 2>/dev/null || echo "paho-mqtt: MISSING (only needed for daemon)"; \
	echo; \
	echo "== bluez tools =="; \
	command -v bluetoothctl >/dev/null 2>&1 && echo "bluetoothctl: OK" || echo "bluetoothctl: MISSING"; \
	command -v btmgmt >/dev/null 2>&1 && echo "btmgmt: OK" || echo "btmgmt: MISSING"; \
	echo; \
	echo "== bluetooth service =="; \
	systemctl is-active bluetooth 2>/dev/null || echo "bluetooth service: unknown/inactive"; \
	echo; \
	echo "== adapters =="; \
	bluetoothctl list 2>/dev/null || echo "impossible de lister les adaptateurs"; \
	echo; \
	echo "== selected adapter =="; \
	if bluetoothctl list 2>/dev/null | grep -q "{{adapter}}"; then \
	  echo "adapter {{adapter}}: FOUND"; \
	else \
	  echo "adapter {{adapter}}: NOT FOUND"; \
	fi; \
	echo; \
	echo "doctor done"

# Run bridge in continuous MQTT daemon mode
run-daemon address=default_address adapter=default_adapter:
	@if [[ -z "{{address}}" ]]; then \
	  echo "address requis: just run-daemon EA:81:4A:8C:98:0C hci1"; \
	  exit 1; \
	fi
	@just py "src/potager_ble.py --address '{{address}}' --adapter '{{adapter}}' daemon"

# Run bridge in daemon mode with debug logs
run-daemon-debug address=default_address adapter=default_adapter:
	@if [[ -z "{{address}}" ]]; then \
	  echo "address requis: just run-daemon-debug EA:81:4A:8C:98:0C hci1"; \
	  exit 1; \
	fi
	@just py "src/potager_ble.py --address '{{address}}' --adapter '{{adapter}}' --debug daemon"

# Send command locally without MQTT (one-shot BLE)
send action="on" address=default_address adapter=default_adapter:
	@if [[ -z "{{address}}" ]]; then \
	  echo "address requis: just send on EA:81:4A:8C:98:0C hci1"; \
	  exit 1; \
	fi
	@just py "src/potager_ble.py --address '{{address}}' --adapter '{{adapter}}' send {{action}}"

# Send command locally without MQTT and with debug logs
send-debug action="on" address=default_address adapter=default_adapter:
	@if [[ -z "{{address}}" ]]; then \
	  echo "address requis: just send-debug on EA:81:4A:8C:98:0C hci1"; \
	  exit 1; \
	fi
	@just py "src/potager_ble.py --address '{{address}}' --adapter '{{adapter}}' --debug send {{action}}"

# Set both channels intensity using preset names (off|photo|faible|printemps|ete)
set-intensity preset="printemps" address=default_address adapter=default_adapter:
	@if [[ -z "{{address}}" ]]; then \
	  echo "address requis: just set-intensity printemps EA:81:4A:8C:98:0C hci1"; \
	  exit 1; \
	fi
	@p="{{preset}}"; \
	p="${p#preset=}"; \
	just py "src/potager_ble.py --address '{{address}}' --adapter '{{adapter}}' set --left-intensity '${p}' --right-intensity '${p}'"

# Set cycle schedule for both channels
set-cycle start="08:00" end="22:00" address=default_address adapter=default_adapter:
	@if [[ -z "{{address}}" ]]; then \
	  echo "address requis: just set-cycle 08:00 22:00 EA:81:4A:8C:98:0C hci1"; \
	  exit 1; \
	fi
	@s="{{start}}"; \
	e="{{end}}"; \
	s="${s#start=}"; \
	e="${e#end=}"; \
	just py "src/potager_ble.py --address '{{address}}' --adapter '{{adapter}}' set --left-start '${s}' --right-start '${s}' --left-end '${e}' --right-end '${e}'"

# Set internal clock to current local time
set-clock-now address=default_address adapter=default_adapter:
	@if [[ -z "{{address}}" ]]; then \
	  echo "address requis: just set-clock-now EA:81:4A:8C:98:0C hci1"; \
	  exit 1; \
	fi
	@just py "src/potager_ble.py --address '{{address}}' --adapter '{{adapter}}' set --clock-now"

# Save current auto-mode channels to JSON snapshot
auto-save file="" address=default_address adapter=default_adapter:
	@if [[ -z "{{address}}" ]]; then \
	  echo "address requis: just auto-save '' EA:81:4A:8C:98:0C hci1"; \
	  exit 1; \
	fi
	@f="{{file}}"; \
	if [[ -n "$f" ]]; then \
	  just py "src/potager_ble.py --address '{{address}}' --adapter '{{adapter}}' auto-save --auto-state-file '${f}'"; \
	else \
	  just py "src/potager_ble.py --address '{{address}}' --adapter '{{adapter}}' auto-save"; \
	fi

# Restore auto-mode channels from JSON snapshot
auto-restore file="" use_saved_clock="0" address=default_address adapter=default_adapter:
	@if [[ -z "{{address}}" ]]; then \
	  echo "address requis: just auto-restore '' 0 EA:81:4A:8C:98:0C hci1"; \
	  exit 1; \
	fi
	@f="{{file}}"; \
	u="{{use_saved_clock}}"; \
	cmd="src/potager_ble.py --address '{{address}}' --adapter '{{adapter}}' auto-restore"; \
	if [[ -n "$f" ]]; then \
	  cmd="$cmd --auto-state-file '${f}'"; \
	fi; \
	if [[ "$u" == "1" || "$u" == "true" || "$u" == "yes" ]]; then \
	  cmd="$cmd --use-saved-clock"; \
	fi; \
	just py "$cmd"

# Run command locally with explicit BLE address
run-address action="on" address="" adapter=default_adapter:
	@if [[ -z "{{address}}" ]]; then \
	  echo "address requis: just run-address on EA:81:4A:8C:98:0C hci1"; \
	  exit 1; \
	fi
	@just py "src/potager_ble.py --address '{{address}}' --adapter '{{adapter}}' send {{action}}"

# Build the production image
docker-build:
	docker build -t {{image}} "{{project_dir}}"

# Run container once with explicit BLE address
docker-run action="on" address="" adapter=default_adapter:
	@if [[ -z "{{address}}" ]]; then \
	  echo "address requis: just docker-run on EA:81:4A:8C:98:0C hci1"; \
	  exit 1; \
	fi
	docker run --rm --net=host --privileged -v /var/run/dbus:/var/run/dbus -v "{{project_dir}}/state:/data" {{image}} --adapter "{{adapter}}" send {{action}} --address "{{address}}"

# Run container once with explicit BLE address
docker-run-address action="on" address="" adapter=default_adapter:
	@if [[ -z "{{address}}" ]]; then \
	  echo "address requis: just docker-run-address on EA:81:4A:8C:98:0C hci1"; \
	  exit 1; \
	fi
	docker run --rm --net=host --privileged -v /var/run/dbus:/var/run/dbus -v "{{project_dir}}/state:/data" {{image}} --adapter "{{adapter}}" send {{action}} --address "{{address}}"

# Start compose stack with forced rebuild and recreate
compose-up:
	docker compose -f "{{project_dir}}/docker-compose.yml" build --no-cache potager-ble
	docker compose -f "{{project_dir}}/docker-compose.yml" up -d --force-recreate --remove-orphans

# Stop compose stack
compose-down:
	docker compose -f "{{project_dir}}/docker-compose.yml" down

# Follow service logs
compose-logs:
	docker compose -f "{{project_dir}}/docker-compose.yml" logs -f potager-ble

# Restart service container
compose-restart:
	docker compose -f "{{project_dir}}/docker-compose.yml" restart potager-ble

# Publish one MQTT payload using the app image (no local mosquitto_pub needed)
[private]
mqtt-pub payload host=default_host port=default_port topic=default_topic username="" password="":
	@host_val="{{host}}"; \
	port_val="{{port}}"; \
	topic_val="{{topic}}"; \
	username_val="{{username}}"; \
	password_val="{{password}}"; \
	host_val="${host_val#host=}"; \
	port_val="${port_val#port=}"; \
	topic_val="${topic_val#topic=}"; \
	username_val="${username_val#username=}"; \
	password_val="${password_val#password=}"; \
	if [[ -n "${username_val}" ]]; then \
	  docker run --rm --network host --entrypoint python {{image}} -c \
	    "from paho.mqtt.publish import single; single('${topic_val}', payload='{{payload}}', hostname='${host_val}', port=int('${port_val}'), qos=1, retain=True, auth={'username':'${username_val}','password':'${password_val}'})"; \
	else \
	  docker run --rm --network host --entrypoint python {{image}} -c \
	    "from paho.mqtt.publish import single; single('${topic_val}', payload='{{payload}}', hostname='${host_val}', port=int('${port_val}'), qos=1, retain=True)"; \
	fi

# Publish ON via MQTT broker
mqtt-on host=default_host username="" password="":
	@just mqtt-pub ON {{host}} {{default_port}} {{default_topic}} "{{username}}" "{{password}}"

# Publish OFF via MQTT broker
mqtt-off host=default_host username="" password="":
	@just mqtt-pub OFF {{host}} {{default_port}} {{default_topic}} "{{username}}" "{{password}}"
