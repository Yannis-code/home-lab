project_dir := justfile_directory()
compose := "docker compose --project-directory " + project_dir

# List available portal commands
default:
	@just --list

# Build the Angular portal image
build:
	@{{compose}} build portal

# Start the standalone portal stack
up:
	@{{compose}} up -d

# Stop the standalone portal stack
down:
	@{{compose}} down

# Restart the portal container
restart:
	@{{compose}} restart portal

# Follow portal logs
logs:
	@{{compose}} logs -f portal

# Show portal container status
status:
	@{{compose}} ps

# Validate the portal Compose configuration
config:
	@{{compose}} config --quiet